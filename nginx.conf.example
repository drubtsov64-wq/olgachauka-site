# Пример конфига Nginx для olgachauka.ru
# Путь на сервере: /etc/nginx/sites-available/olgachauka.ru
# После создания: ln -s /etc/nginx/sites-available/olgachauka.ru /etc/nginx/sites-enabled/
# Проверка: nginx -t
# Применить: systemctl reload nginx

server {
    listen 80;
    server_name olgachauka.ru www.olgachauka.ru;

    # После настройки SSL через certbot этот блок заменится автоматически
    # certbot --nginx -d olgachauka.ru -d www.olgachauka.ru

    location / {
        proxy_pass         http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 10s;
    }
}
